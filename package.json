{
  "name": "rubrilab",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.mjs",
  "description": "A local app for organising laboratory sessions, student groups and assessment evidence while teaching.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && node scripts/package-electron.mjs --dir",
    "electron:dist": "npm run build && node scripts/package-electron.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "lucide-react": "^1.41.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vinext": "^0.0.50",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.rubrilab.app",
    "productName": "RubriLab",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": false,
    "icon": "public/rubrilab-icon-transparent.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "category": "Education",
      "target": ["AppImage"]
    }
  }
}
